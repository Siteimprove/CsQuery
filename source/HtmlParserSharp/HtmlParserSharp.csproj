<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0</TargetFrameworks>
    <DebugType>portable</DebugType>
    <AssemblyName>HtmlParserSharp</AssemblyName>
    <OutputType>Library</OutputType>
    <PackageId>HtmlParserSharp</PackageId>
    <Version>2.0.1</Version>
    <Authors>Patrick Reisert, James Treworgy</Authors>
    <Description>A C# port of the Validator.nu HTML5 parser.</Description>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <RepositoryUrl>https://github.com/Siteimprove/CsQuery</RepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
